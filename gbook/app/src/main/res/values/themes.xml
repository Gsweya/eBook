<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GBook" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Dark bar icons on the light window, light ones at night, until the app applies its own appearance setting. -->
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_bars</item>
    </style>

    <!-- Launch splash: the book glyph opens on the accent circle, then MainActivity fades it into the app. -->
    <style name="Theme.GBook.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">820</item>
        <item name="postSplashScreenTheme">@style/Theme.GBook</item>
    </style>
</resources>
